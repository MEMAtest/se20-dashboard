<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="JOURNEY / DEPARTURES" android:textColor="#0057D9" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:id="@+id/widget_settings" android:layout_width="44dp" android:layout_height="40dp" android:gravity="center" android:text="Edit" android:textSize="12sp" android:textColor="#244268" android:contentDescription="Edit widget station and destination"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a station" android:textSize="21sp" android:textStyle="bold" android:textColor="#10253F" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_departures" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Add your station to see the next departures." android:textColor="#10253F" android:textSize="14sp" android:gravity="center_vertical" android:maxLines="5"/>
    <TextView android:id="@+id/widget_alert" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TfL predictions, not all National Rail services" android:textSize="11sp" android:textColor="#815500" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_checked" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Snapshot - refresh before travel" android:textSize="11sp" android:textColor="#52657D" android:maxLines="2" android:paddingTop="5dp" android:paddingBottom="7dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp">
        <TextView android:id="@+id/widget_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Open Journey" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_button" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="86dp" android:layout_height="match_parent" android:gravity="center" android:text="Refresh" android:textColor="#0057D9" android:textStyle="bold" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
