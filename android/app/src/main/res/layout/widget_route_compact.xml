<?xml version="1.0"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compact_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_card">
  <LinearLayout android:id="@+id/compact_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <ImageView android:id="@+id/route_pin" android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/compact_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="My journey" android:textSize="14sp" android:textStyle="bold" android:textColor="#111B35" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp"/>
      <TextView android:id="@+id/route_arrival" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arrive --:--" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/compact_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Leave in &#xB7; min:sec" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <FrameLayout android:id="@+id/clock_frame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
          <TextView android:id="@+id/compact_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check" android:textSize="24sp" android:textColor="#0C1533" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_gravity="center_vertical" android:textStyle="bold"/>
          <Chronometer android:id="@+id/compact_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:includeFontPadding="false" android:textSize="24sp" android:textStyle="bold" android:textColor="#1748ED" android:visibility="gone" android:maxLines="1"/>
        </FrameLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/route_legs" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="53dp" android:orientation="horizontal" android:visibility="gone">
        <LinearLayout android:id="@+id/leg_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="3dp" android:layout_marginStart="3dp" android:background="@drawable/widget_chip">
          <ImageView android:id="@+id/leg_icon_0" android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_walk" android:importantForAccessibility="no"/>
          <TextView android:id="@+id/leg_label_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="9sp" android:textColor="#1D315C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
          <TextView android:id="@+id/leg_time_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/leg_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="3dp" android:layout_marginStart="3dp" android:background="@drawable/widget_chip">
          <ImageView android:id="@+id/leg_icon_1" android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_train" android:importantForAccessibility="no"/>
          <TextView android:id="@+id/leg_label_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="9sp" android:textColor="#1D315C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
          <TextView android:id="@+id/leg_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/leg_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="3dp" android:layout_marginStart="3dp" android:background="@drawable/widget_chip">
          <ImageView android:id="@+id/leg_icon_2" android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_walk" android:importantForAccessibility="no"/>
          <TextView android:id="@+id/leg_label_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="9sp" android:textColor="#1D315C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
          <TextView android:id="@+id/leg_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/compact_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check a route before travel" android:textSize="10sp" android:textColor="#4F5972" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    <Chronometer android:id="@+id/compact_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No verified update" android:textSize="9sp" android:textColor="#59647D" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/compact_footer" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="5dp" android:background="@drawable/widget_footer">
    <ImageView android:id="@+id/compact_refresh" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_refresh_blue" android:padding="5dp" android:contentDescription="Refresh journey estimate" android:importantForAccessibility="yes"/>
    <TextView android:id="@+id/route_origin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="From your station" android:textSize="10sp" android:textColor="#43516D" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/route_open" android:layout_width="wrap_content" android:layout_height="26dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Open journey &#x2197;" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_blue"/>
  </LinearLayout>
</LinearLayout>
