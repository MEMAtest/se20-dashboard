<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compact_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/compact_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT UP / ANERLEY" android:textSize="12sp" android:textStyle="bold" android:textColor="#244268" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/compact_value" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="--:--" android:textSize="34sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textColor="#073BC6" android:maxLines="1"/>
        <ImageView android:id="@+id/compact_refresh" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp" android:src="@drawable/ic_refresh" android:contentDescription="Refresh departures"/>
    </LinearLayout>
    <TextView android:id="@+id/compact_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose your station" android:textSize="14sp" android:textStyle="bold" android:textColor="#10253F" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/compact_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TfL departures snapshot" android:textSize="11sp" android:textColor="#52657D" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp"/>
    <TextView android:id="@+id/compact_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to refresh" android:textSize="11sp" android:textColor="#52657D" android:maxLines="2" android:paddingTop="5dp"/>
</LinearLayout>
