<?xml version="1.0"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compact_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_card">
  <LinearLayout android:id="@+id/compact_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <ImageView android:id="@+id/next_pin" android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_pin" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/compact_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Choose a stop" android:textStyle="bold" android:textSize="13sp" android:textColor="#10172C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/next_service" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical">
      <ImageView android:id="@+id/next_mode" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bus" android:importantForAccessibility="no"/>
      <TextView android:id="@+id/next_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="TfL" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/widget_blue"/>
    </LinearLayout>
    <TextView android:id="@+id/compact_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Next departure" android:textSize="14sp" android:textColor="#11182C" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
    <FrameLayout android:id="@+id/clock_frame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <TextView android:id="@+id/compact_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check" android:textSize="36sp" android:textColor="#0C1533" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_gravity="center_vertical" android:textStyle="bold"/>
      <Chronometer android:id="@+id/compact_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:includeFontPadding="false" android:textSize="36sp" android:textStyle="bold" android:textColor="#1748ED" android:visibility="gone" android:maxLines="1"/>
    </FrameLayout>
    <TextView android:id="@+id/compact_extra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Then --" android:textSize="11sp" android:textColor="#556079" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/compact_footer" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:background="@drawable/widget_footer">
    <ImageView android:id="@+id/compact_refresh" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_refresh_blue" android:padding="5dp" android:contentDescription="Refresh widget" android:importantForAccessibility="yes"/>
    <Chronometer android:id="@+id/compact_meta" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tap to refresh" android:textSize="10sp" android:textColor="#505D7A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
</LinearLayout>
